# ─── App (VPS / self-hosted) ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://midtravel.hu"
NEXT_PUBLIC_SITE_URL="https://midtravel.hu"
# Local development:
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Postgres (Docker Compose or VPS-installed) ───────────────────────────────
POSTGRES_USER="midtravel"
POSTGRES_PASSWORD="change-me-strong-password"
POSTGRES_DB="midtravel"
# Host port only for local `npm run docker:db`. Production Compose does not publish 5432.
POSTGRES_PORT="5432"
APP_PORT="3000"

# App connection (Compose `app` overrides this to db:5432 automatically)
DATABASE_URL="postgresql://midtravel:change-me-strong-password@localhost:5432/midtravel?schema=public"
DIRECT_URL="postgresql://midtravel:change-me-strong-password@localhost:5432/midtravel?schema=public"

# Local file uploads (VPS default). Mount/persist this path on the VPS.
UPLOAD_DIR="./uploads"

# Optional: Vercel Blob (used when set; otherwise local UPLOAD_DIR).
# BLOB_READ_WRITE_TOKEN=""

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Canonical public URL (apex, no trailing slash). The www counterpart is
# always added to trustedOrigins so login works if both hosts are reachable.
BETTER_AUTH_URL="https://midtravel.hu"
# Optional extra origins (comma-separated), e.g. a staging host.
# BETTER_AUTH_TRUSTED_ORIGINS="https://staging.midtravel.hu"

# ─── Seed (optional overrides) ────────────────────────────────────────────────
# Default `npm run db:seed` is safe: creates missing rows only.
# Overwrite catalog content only with `npm run db:seed:force` (not for production).
SEED_ADMIN_EMAIL="admin@midtravel.hu"
SEED_ADMIN_PASSWORD="ChangeMeNow!23"
SEED_ADMIN_NAME="MidTravel Admin"

# ─── Sentry (optional) ────────────────────────────────────────────────────────
# Client SDK only sends after cookie consent. Leave empty = no banner, no browser events.
# Server-side errors still report when DSN is set (no browser cookie).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ─── Resend (transactional email: contact, apply, booking, password reset, verify) ───
RESEND_API_KEY=""
# Until midtravel.hu is verified in Resend, use: MidTravel <onboarding@resend.dev>
RESEND_FROM_EMAIL="MidTravel <hello@midtravel.hu>"
CONTACT_NOTIFY_EMAIL="midtravel2019@gmail.com"
# Optional testing redirect — all outbound mail goes here when set
# EMAIL_OVERRIDE="you@example.com"

# ─── Stripe (bookings / deposit checkout) ─────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Deposit percent of total trip price (travel contract default: 30)
STRIPE_DEPOSIT_PERCENT="30"

# ─── szamlazz.hu (manual invoice button in admin) ─────────────────────────────
# Agent key from szamlazz.hu dashboard → Számla Agent kulcsok
SZAMLAZZ_AGENT_KEY=""
# ÁFA kulcs (szám: 27/18/5/0, vagy szöveg: TAM / AAM / EU) — egyeztesd a könyvelővel
SZAMLAZZ_VAT_PERCENT="27"
# EUR számlákhoz kötelező MNB árfolyam (HUF / 1 EUR)
SZAMLAZZ_EUR_HUF_RATE=""
# Elektronikus számla (alapértelmezett: true)
SZAMLAZZ_E_INVOICE="true"

# ─── Rate limiting ────────────────────────────────────────────────────────────
# In-memory IP throttle (per process). Limits: contact/apply/booking 5/min, auth 30/min.
# Production nginx also applies limit_req (see deploy/nginx-http.conf).

# ─── Backup (deploy/backup.sh) ────────────────────────────────────────────────
# Default mode auto-detects a running Compose `db` service; otherwise uses local pg_dump.
# BACKUP_MODE="compose"
# BACKUP_DIR="./backups"
# BACKUP_RETENTION_DAYS="14"
# HEALTHCHECK_URL="http://127.0.0.1:3000/api/health"
