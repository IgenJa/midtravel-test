# ─── App (VPS / self-hosted) ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://midtravel.hu"
NEXT_PUBLIC_SITE_URL="https://midtravel.hu"
# Local development:
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Postgres (Docker Compose or VPS-installed) ───────────────────────────────
POSTGRES_USER="midtravel"
POSTGRES_PASSWORD="change-me-strong-password"
POSTGRES_DB="midtravel"
POSTGRES_PORT="5432"
APP_PORT="3000"

# App connection (Compose overrides this for the `app` service automatically)
DATABASE_URL="postgresql://midtravel:change-me-strong-password@localhost:5432/midtravel?schema=public"
DIRECT_URL="postgresql://midtravel:change-me-strong-password@localhost:5432/midtravel?schema=public"

# Local file uploads (VPS default). Mount/persist this path on the VPS.
UPLOAD_DIR="./uploads"

# Optional: Vercel Blob (used when set; otherwise local UPLOAD_DIR).
# BLOB_READ_WRITE_TOKEN=""

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://midtravel.hu"

# ─── Seed (optional overrides) ────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@midtravel.hu"
SEED_ADMIN_PASSWORD="ChangeMeNow!23"
SEED_ADMIN_NAME="MidTravel Admin"

# ─── Sentry (optional) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ─── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY=""
# Until your domain is verified in Resend, use: MidTravel <beth.t@example.com>
RESEND_FROM_EMAIL="MidTravel <hello@midtravel.hu>"
CONTACT_NOTIFY_EMAIL="info@midtravel.hu"
# Optional testing redirect — all outbound mail goes here when set
# EMAIL_OVERRIDE="you@example.com"

# ─── Stripe (bookings / deposit checkout) ─────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Deposit percent of total trip price (travel contract default: 30)
STRIPE_DEPOSIT_PERCENT="30"

# ─── szamlazz.hu (manual invoice button in admin) ─────────────────────────────
# Agent key from szamlazz.hu dashboard → Számla Agent kulcsok
SZAMLAZZ_AGENT_KEY=""
# ÁFA kulcs (szám: 27/18/5/0, vagy szöveg: TAM / AAM / EU) — egyeztesd a könyvelővel
SZAMLAZZ_VAT_PERCENT="27"
# EUR számlákhoz kötelező MNB árfolyam (HUF / 1 EUR)
SZAMLAZZ_EUR_HUF_RATE=""
# Elektronikus számla (alapértelmezett: true)
SZAMLAZZ_E_INVOICE="true"

# ─── Rate limiting ────────────────────────────────────────────────────────────
# In-memory IP throttle (per process). Limits: contact/apply/booking 5/min, auth 30/min.
# For multi-instance production, put a reverse-proxy rate limit in nginx as well.
